<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Widget Provider Receiver -->
        <receiver
            android:name=".AlphabetWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.starlauncher.ACTION_LETTER_TOUCHED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alphabet_widget_info" />
        </receiver>

        <!-- Floating Paper Square Modal -->
        <activity
            android:name=".SketchbookModalActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:exported="false" />

    </application>

</manifest>
